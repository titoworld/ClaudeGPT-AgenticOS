# ClaudeGPT OS: server configuration (full guide: docs/DEPLOYMENT.md).
#
#   cp .env.example .env && chmod 600 .env && nano .env
#
# The .env file holds secrets: never commit it to the repository (it is already
# in .gitignore). If a value contains the $ character, put it in single quotes:
# KEY='a$b'. Lines that start with # have no effect: remove the # to turn them on.

# ---- Domain and certificate -------------------------------------------------
# Domain that points to the VPS (DNS A/AAAA records), without https:// or a
# trailing slash.
DOMAIN=ia.example.com
# Email of the certificates' ACME account. Let's Encrypt no longer sends expiry
# warnings (since June 2025): a failed renewal shows up in "docker compose logs caddy".
ACME_EMAIL=tu@example.com

# ---- App --------------------------------------------------------------------
# The exact address you open the app at in the browser.
AOS_PUBLIC_ORIGIN=https://${DOMAIN}
# Cookies over HTTPS only. Leave it at true on the server.
AOS_SECURE_COOKIES=true
# Docker's internal network where Caddy is (the "proxy" network of docker-compose.yml).
# Only the X-Forwarded-* headers that come from here are trusted.
AOS_TRUSTED_PROXIES=172.30.0.0/24

# Local development without Docker (uv run agentic-os serve): use
# AOS_PUBLIC_ORIGIN=http://localhost:8000 and AOS_SECURE_COOKIES=false.

# ---- Providers --------------------------------------------------------------
# cli:  your subscription (Claude Pro/Max, ChatGPT Plus/Pro) through the official CLIs.
# api:  API keys, paid per use.
# fake: test answers, at no cost (to try the interface).
AOS_CLAUDE_MODE=cli
AOS_CHATGPT_MODE=cli

# Models (optional). When they are not set, each mode uses its default model.
# AOS_CLAUDE_MODEL=
# AOS_CLAUDE_FAST_MODEL=
# AOS_CHATGPT_MODEL=
# AOS_CHATGPT_FAST_MODEL=

# ---- Claude with the subscription (cli mode) --------------------------------
# One-year token, generated with: docker compose exec -it app claude setup-token
# Alternative without a token: docker compose exec -it app claude auth login
# (the session is saved in the app_home volume and this line is not needed).
# CLAUDE_CODE_OAUTH_TOKEN=

# ChatGPT with the subscription uses no variable: log in once
# with docker compose exec -it app codex login --device-auth

# ---- API keys (api mode only) -----------------------------------------------
# IMPORTANT: in cli mode, leave ANTHROPIC_API_KEY commented out. If the Claude CLI
# finds it, it takes priority over the subscription and everything is billed
# through the API.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---- Access (optional) ------------------------------------------------------
# Only these IPs or networks will be able to open the web app, separated by spaces.
# Empty = everyone (the password and the TOTP code still protect access).
# If someone is trying passwords and you often get "Too many attempts", limiting
# access here stops it. The browsers where you have already logged in are not
# locked out, but while the attack lasts a new device will only be able to log
# in with this list or with a VPN.
# Example: ALLOWED_IPS=203.0.113.7/32 2001:db8:1234::/48
ALLOWED_IPS=

# ---- Resources (optional) ---------------------------------------------------
# CPU cores the app can use (1.5 by default, so that on a 2-vCPU VPS there are
# always some left for Caddy and SSH). Never more than the server's vCPUs: with
# a single vCPU, set it to 1.
# APP_CPUS=1.5

# ---- CLI versions (optional, advanced) --------------------------------------
# By default, the ones pinned in the Dockerfile are used: the ones the app
# supports. Change them only if you know that the new version is compatible.
# CLAUDE_CLI_VERSION=2.1.283
# CODEX_CLI_VERSION=0.157.1

# ---- Data volumes (managed by deploy/restore.sh) ----------------------------
# Docker volumes with the database and the CLI logins. On a fresh install, leave
# these lines commented out: claudegpt_app_data and claudegpt_app_home are used.
# deploy/restore.sh restores backups into new volumes and adds their names at
# the end of this file: don't change them by hand.
# APP_DATA_VOLUME=claudegpt_app_data
# APP_HOME_VOLUME=claudegpt_app_home
